# ==============================================================================
# LEADS OUTREACH ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and populate with your production credentials.
# Never commit .env.local into source control.

# 1. Serper.dev Google Maps Places API Key (2,500 free queries at serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# 2. Google Gemini AI API Key (Personalized pitch generation per business)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Fonnte WhatsApp Gateway API Token (https://api.fonnte.com/send)
FONNTE_API_TOKEN=your_fonnte_api_token_here
FONNTE_TOKEN=your_fonnte_api_token_here

# 4. Google Sheets Apps Script Web App URL (Database & Anti-duplication blacklist)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/your_deployment_id/exec
NEXT_PUBLIC_LEADS_SHEET_API=https://script.google.com/macros/s/your_deployment_id/exec
